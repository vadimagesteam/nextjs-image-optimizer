{
  "name": "vadimages-nextjs-image-optimizer",
  "version": "1.7.1",
  "description": "Auto image optimization with mobile image support",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./dist/optimizeImages.js",
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "dist/optimizeImages.d.ts",
    "dist/optimizeImages.js"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc && tsc --project tsconfig.optimizeImages.json && npm run verify-dist",
    "verify-dist": "node scripts/verify-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev-optimization": "tsx src/optimizeImages.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vadimagesteam/nextjs-image-optimizer.git"
  },
  "keywords": [
    "nextjs",
    "image",
    "optimization",
    "webp"
  ],
  "author": "Mykhailo Shumilov",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vadimagesteam/nextjs-image-optimizer/issues"
  },
  "homepage": "https://github.com/vadimagesteam/nextjs-image-optimizer#readme",
  "devDependencies": {
    "@types/cli-progress": "^3.11.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "next": "^15 || ^16",
    "react": "^18 || ^19"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.592.0",
    "@supercharge/promise-pool": "^3.2.0",
    "cli-progress": "^3.12.0",
    "colors": "1.4.0",
    "md5": "^2.3.0",
    "mime-types": "^2.1.35",
    "sharp": "^0.33.4"
  }
}
